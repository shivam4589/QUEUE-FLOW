# One image that serves the dashboard, the API and (when JOBQUEUE_WORKER_ENABLED=true) the workers.
# Used for simple single-service hosting such as Render. Local development keeps using ./Dockerfile.

# ---  build the React dashboard 
FROM node:22-alpine AS web
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/index.html frontend/vite.config.js ./
COPY frontend/src ./src
RUN npm run build

# ----  build the Spring Boot jar, with the dashboard packaged as static files --
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app
COPY pom.xml .
RUN mvn -q -B dependency:go-offline
COPY src ./src
COPY --from=web /web/dist ./src/main/resources/static
RUN mvn -q -B package -DskipTests

# -- 3. run --
FROM eclipse-temurin:21-jre
WORKDIR /app
RUN useradd --system --no-create-home appuser
COPY --from=build /app/target/jobqueue-*.jar app.jar
USER appuser
EXPOSE 8080
# Small heap and a lightweight JIT so it fits a 512 MB free instance.
ENV JAVA_TOOL_OPTIONS="-Xmx200m -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -Xss512k"
ENTRYPOINT ["java", "-jar", "app.jar"]
